#!/usr/bin/with-contenv bashio

# The CLI keeps ~/.claude.json (onboarding state, settings) outside ~/.claude/,
# so persist it in /data too. Without it the CLI treats every rebuild as a
# fresh install and can hang on first-run onboarding in headless mode.
CLAUDE_JSON=/data/.claude.json
if [ ! -s "${CLAUDE_JSON}" ]; then
    latest_backup=$(ls -t /data/.claude/backups/.claude.json.backup.* 2>/dev/null | head -n1)
    if [ -n "${latest_backup}" ]; then
        bashio::log.info "Restoring ${CLAUDE_JSON} from ${latest_backup}"
        cp "${latest_backup}" "${CLAUDE_JSON}"
    else
        bashio::log.info "Seeding ${CLAUDE_JSON}"
        echo '{"hasCompletedOnboarding": true}' > "${CLAUDE_JSON}"
    fi
fi
ln -sf "${CLAUDE_JSON}" /root/.claude.json

exec node /app/src/server.js
